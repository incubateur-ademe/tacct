{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "target": "ES2023",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tailwind.config.js",
    "./src/lib/json-db/types.d.ts",
    "next.config.mjs",
    ".next/dev/types/**/*.ts",
    "src/app/(main)/(parcours)/patch4c/components/DromAccordion.tsx",
    "src/app/(main)/(parcours)/patch4c/components/DromAccordion.bak",
    "scripts/lire-user.mjs",
    "scripts/lire-user.js"
  ],
  "exclude": ["node_modules", "playwright.config.ts", "e2e"]
}
