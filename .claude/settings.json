{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rtk grep:*)",
      "Bash(rtk read:*)",
      "Bash(rtk find:*)",
      "Bash(rtk ls:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env*)",
      "Read(./**/.env)",
      "Read(./**/.env*)",
      "Bash(cat:*.env*)",
      "Bash(rtk read:*.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/block-env.sh"
          }
        ]
      }
    ]
  }
}
