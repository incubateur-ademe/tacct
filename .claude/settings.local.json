{
  "permissions": {
    "allow": [
      "WebFetch(domain:data.geopf.fr)",
      "WebFetch(domain:cartes.gouv.fr)",
      "WebSearch",
      "Bash(rtk ls:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(rtk find:*)",
      "Bash(rtk grep *)",
      "Bash(rtk tsc *)",
      "Bash(rtk lint *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(cat:*.env*)",
      "Bash(rtk read:*.env*)"
    ]
  }
}
